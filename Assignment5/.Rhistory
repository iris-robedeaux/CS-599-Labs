ggplot(df, aes(x = epoch,
y = accuracy,
color = type,
linetype = factor(layers))) +
geom_line(size = 1) +
facet_grid(trial ~ cell_type) +
labs(
x = "Epoch",
y = "Accuracy",
color = "Accuracy Type",
linetype = "Hidden Layers"
) +
theme_bw()
